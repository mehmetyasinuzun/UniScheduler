# Copy this file to local.properties and fill in the values.
# local.properties is gitignored — never commit API keys or signing creds.

sdk.dir=C\:\\Users\\YourName\\AppData\\Local\\Android\\Sdk

# ── Supabase ──────────────────────────────────────────────────────────────
# Get these from Supabase dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Release signing (only required for `./gradlew assembleRelease`) ───────
# Generate a keystore once with:
#   keytool -genkey -v -keystore unischeduler-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias unischeduler
# Keep the .jks file safe and BACKED UP. Losing it means you can never
# update the same app installation on user devices.
KEYSTORE_FILE=C\:\\Users\\YourName\\keystores\\unischeduler-release.jks
KEYSTORE_PASSWORD=your-keystore-password
KEY_ALIAS=unischeduler
KEY_PASSWORD=your-key-password
