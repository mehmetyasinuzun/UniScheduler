# ────────────────────────────────────────────────────────────────────────
# dbmate konfigürasyon örneği
#
# 1. Kopyala: cp supabase/migrations/.dbmate.example.env supabase/migrations/.env
# 2. DATABASE_URL'i Supabase Settings → Database → Connection string'den al
# 3. dbmate komutları artık supabase/ klasöründe çalışır
#
# .env gitignored — gerçek connection string ASLA git'e gitmez.
# ────────────────────────────────────────────────────────────────────────

# Supabase project connection string (pooled connection önerilir — port 6543)
# Örnek: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Migration klasörü (dbmate default'u `db/migrations`, biz Supabase yapısına uyuyoruz)
DBMATE_MIGRATIONS_DIR=supabase/migrations

# Schema dosyası (dbmate dump çıktısı — git'e gider, son uygulanan şemayı izler)
DBMATE_SCHEMA_FILE=supabase/schema-dump.sql

# Migration tablosu adı (default `schema_migrations` — değiştirmeyin,
# Supabase'in kendi auth migration tablosuyla çakışmaz)
DBMATE_MIGRATIONS_TABLE=schema_migrations

# Wait time (saniye) — `dbmate wait` komutu için, CI'da DB hazır olmadan
# migration çalıştırmayı engeller.
DBMATE_WAIT_TIMEOUT=30s
