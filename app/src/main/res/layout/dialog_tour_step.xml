<?xml version="1.0" encoding="utf-8"?>
<!--
  Tour adım kartı — TourCoordinator BottomSheetDialog'unda gösterilir.
  Klasik 9 sayfa statik slayt yerine: kullanıcı gerçek sayfaya geçer,
  bu kart o sayfanın altında belirir → buradaki butona basıp sonraki
  sekmeye otomatik geçilir.

  Yapı:
    [emoji başlık + sayfa sayacı]
    [açıklayıcı metin]
    [progress bar]
    [Atla] ............ [İlerle]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp"
    android:background="?attr/colorSurface">

    <!-- Üst satır: başlık + sayfa sayacı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTourTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            tools:text="🏠 Home Sekmesi" />

        <TextView
            android:id="@+id/tvTourCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"
            android:background="@drawable/bg_tour_counter"
            tools:text="2 / 6" />
    </LinearLayout>

    <!-- Açıklayıcı metin -->
    <TextView
        android:id="@+id/tvTourBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="📍 Alt bardan Home sekmesi. Kurumun anlık fotoğrafı..." />

    <!-- Progress bar — bu sayfa /toplam -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressTour"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="20dp"
        app:indicatorColor="?attr/colorPrimary"
        app:trackThickness="3dp" />

    <!-- Alt butonlar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTourSkip"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_skip"
            android:textColor="?android:attr/textColorSecondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTourNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_next"
            app:iconGravity="end"
            app:icon="@drawable/ic_arrow_forward" />
    </LinearLayout>
</LinearLayout>
