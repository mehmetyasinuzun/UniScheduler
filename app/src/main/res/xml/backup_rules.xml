<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules (Android 6.0–11). With android:allowBackup="false" in
  the manifest, Auto Backup is fully off; this file exists only as a
  belt-and-suspenders defense for older devices that may ignore the
  manifest flag in unusual configurations.
-->
<full-backup-content>
    <!-- Exclude every shared_prefs file — including the encrypted session
         and theme/language prefs. Nothing UniScheduler stores is worth
         backing up; everything reproducible from the server. -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
