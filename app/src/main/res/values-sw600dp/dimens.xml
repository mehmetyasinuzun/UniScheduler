<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tablet (≥ 600dp shortest side, hem portrait hem landscape).
         İçerik dar bir merkezi sütunda — form satırları için Material'ın
         tavsiye ettiği ~600dp genişliğin altında, okunaklılık için. -->

    <dimen name="screen_padding">24dp</dimen>
    <dimen name="screen_padding_horizontal">32dp</dimen>
    <dimen name="card_padding">16dp</dimen>
    <dimen name="section_spacing">16dp</dimen>

    <!-- Form alanı 600dp ile sınırlanır; ekran daha geniş olsa da tek
         sütun form yana yayılmaz — "satır çok uzun, takibi zor" problemi
         önlenir. -->
    <dimen name="form_max_width">600dp</dimen>

    <dimen name="page_title_size">26sp</dimen>
    <dimen name="page_subtitle_size">14sp</dimen>
    <dimen name="body_text_size">15sp</dimen>

    <dimen name="empty_state_icon">120dp</dimen>
</resources>
