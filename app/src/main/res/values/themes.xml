<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UniScheduler" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant</item>
        <!-- Material 3 ile geriye doğru uyumluluk: bazı yeni component'lar
             (ör. CircularProgressIndicator, LinearProgressIndicator) trackColor
             için colorSurfaceVariant bekliyor. Theme.MaterialComponents'ta bu
             attr tanımlı değil → InflateException. Açık temada hafif gri,
             koyu temada koyu gri (values-night'ta override). -->
        <item name="colorSurfaceVariant">#E7E0EC</item>

        <!-- Status bar: surface ile aynı renkte (edge-to-edge benzeri temiz görünüm).
             windowLightStatusBar=true → açık temada sistem ikonları (saat/sinyal/pil) koyu çizilir;
             açık arka plan üzerinde okunabilir. values-night/themes.xml false yapar. -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
