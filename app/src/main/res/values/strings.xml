    <!-- Coach mark balonları — kritik 3 yer için -->
    <string name="coach_excel_title">Yüzlerce Hocayı Tek Tıkla</string>
    <string name="coach_excel_body">Excel dosyandaki tüm hocalar 30 saniyede sisteme eklenir. Sistem aynı isimleri otomatik ayırır, şifreleri üretip CSV olarak verir. Bir dene!</string>
    <string name="coach_autosched_title">5 Alternatif Program — Tek Tıkla</string>
    <string name="coach_autosched_body">Bu buton tüm derslikleri, hocaları ve müsaitlikleri analiz eder, 5 farklı geçerli program önerir. En iyisini sen seçersin.</string>
    <string name="coach_pdf_title">Programını PDF\'le</string>
    <string name="coach_pdf_body">Bu menüden haftalık takvimi PDF veya Excel olarak indir. Hocaya/dersliğe göre filtreleyebilirsin.</string>
    <string name="coach_lecturer_pdf_title">Haftanı PDF\'le Sakla</string>
